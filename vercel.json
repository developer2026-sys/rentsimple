{
    "redirects": [
      { "source": "/", "destination": "/app", "permanent": false }
    ],
    "rewrites": [
      { "source": "/assets/(.*)", "destination": "/assets/$1" },
      { "source": "/(.*)", "destination": "/index.html" },
      { "source": "/", "destination": "/index.html" }
    ]
  }